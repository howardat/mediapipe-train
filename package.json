{
  "name": "mediapipe-train",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Record hand-gesture landmarks from a webcam, train a classifier in the browser, export it to run on an edge device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "npm run verify:contract && npm run verify:package",
    "verify:contract": "node scripts/verify-contract.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "sync:ws": "node scripts/sync-workspace.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "postinstall": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "@tensorflow/tfjs": "^4.22.0",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
